; v2a_nyq_engine.lsp
; Nyquist XLISP engine for v2a-nyq.
; Segment format expected from Python:
;   (hue_mean sat_mean val_mean hue_var sat_var val_var motion duration_sec)
;
; Logic flow (aligned with v2a-cx structure):
;   1) Mapping -> segment plans (progression-smoothed)
;   2) 4-track separation (harmony, bass, pad, melody)
;   3) Post-production quantization per track
;   4) score-merge -> timed-seq render

(setf *v2a-scales*
      '((major 0 2 4 5 7 9 11)
        (minor 0 2 3 5 7 8 10)
        (dorian 0 2 3 5 7 9 10)
        (mixolydian 0 2 4 5 7 9 10)
        (pentatonic 0 2 4 7 9)))

(defun v2a-num (x)
  (if (numberp x) x 0.0))

(defun v2a-clamp (x lo hi)
  (max lo (min hi x)))

(defun v2a-clamp01 (x)
  (v2a-clamp x 0.0 1.0))

(defun v2a-sum (xs)
  (if (null xs)
      0.0
      (+ (v2a-num (car xs))
         (v2a-sum (cdr xs)))))

(defun v2a-mean (xs)
  (if (null xs)
      0.0
      (/ (v2a-sum xs) (float (length xs)))))

(defun v2a-column (segments index)
  (if (null segments)
      nil
      (cons (v2a-num (nth index (car segments)))
            (v2a-column (cdr segments) index))))

(defun v2a-known-scale-p (sym)
  (if (assoc sym *v2a-scales*) t nil))

(defun v2a-scale-intervals (sym)
  (let ((entry (assoc sym *v2a-scales*)))
    (if entry
        (cdr entry)
        '(0 2 4 5 7 9 11))))

(defun v2a-auto-scale (segments mood)
  (let* ((sat (v2a-mean (v2a-column segments 1)))
         (val (v2a-mean (v2a-column segments 2)))
         (hue-var (v2a-mean (v2a-column segments 3)))
         (motion (v2a-mean (v2a-column segments 6))))
    (cond
      ((eq mood 'cheerful) 'major)
      ((eq mood 'epic) 'mixolydian)
      ((> motion 0.35) 'dorian)
      ((> sat 0.58) 'major)
      ((< val 0.36) 'minor)
      ((> hue-var 0.24) 'mixolydian)
      (t 'pentatonic))))

(defun v2a-resolve-scale (segments scale-override mood)
  (if (and scale-override (v2a-known-scale-p scale-override))
      scale-override
      (v2a-auto-scale segments mood)))

(defun v2a-auto-bpm (segments mood)
  (let* ((motion (v2a-mean (v2a-column segments 6)))
         (sat (v2a-mean (v2a-column segments 1)))
         (val-var (v2a-mean (v2a-column segments 5)))
         (base (+ 72.0 (* 88.0 motion) (* 26.0 sat) (* 18.0 val-var)))
         (scaled
           (cond
             ((eq mood 'cheerful) (* base 1.10))
             ((eq mood 'epic) (* base 0.92))
             (t base))))
    (truncate (v2a-clamp (+ 0.5 scaled) 42.0 196.0))))

(defun v2a-midi-from-scale-degree (scale degree base-midi)
  (let* ((n (length scale))
         (idx (rem degree n))
         (oct (truncate (/ degree n))))
    (+ base-midi (nth idx scale) (* 12 oct))))

(defun v2a-wrap-degree (x n)
  (let ((r (rem x n)))
    (if (< r 0) (+ r n) r)))

(defun v2a-ring-degree-distance (a b n)
  (let* ((aa (v2a-wrap-degree a n))
         (bb (v2a-wrap-degree b n))
         (d (abs (- aa bb))))
    (min d (- n d))))

(defun v2a-smooth-degree-progression (prev target n max-step)
  (let* ((nn (max 1 n))
         (tg (v2a-wrap-degree target nn)))
    (if (null prev)
        tg
        (let* ((pv (v2a-wrap-degree prev nn))
               (cw (v2a-wrap-degree (- tg pv) nn))
               (ccw (v2a-wrap-degree (- pv tg) nn)))
          (if (<= (min cw ccw) max-step)
              tg
              (if (<= cw ccw)
                  (v2a-wrap-degree (+ pv max-step) nn)
                  (v2a-wrap-degree (- pv max-step) nn)))))))

(defun v2a-segment-activity (segment)
  (let* ((motion (v2a-clamp01 (v2a-num (nth 6 segment))))
         (hue-var (v2a-clamp01 (v2a-num (nth 3 segment))))
         (sat-var (v2a-clamp01 (* 6.0 (v2a-num (nth 4 segment)))))
         (val-var (v2a-clamp01 (* 6.0 (v2a-num (nth 5 segment))))))
    (v2a-clamp01 (+ (* 0.50 motion)
                    (* 0.22 hue-var)
                    (* 0.16 sat-var)
                    (* 0.12 val-var)))))

(defun v2a-target-root-degree (segment seg-index scale-len)
  (let* ((h (v2a-clamp01 (v2a-num (nth 0 segment))))
         (s (v2a-clamp01 (v2a-num (nth 1 segment))))
         (h-var (v2a-clamp01 (v2a-num (nth 3 segment))))
         (v-var (v2a-clamp01 (* 6.0 (v2a-num (nth 5 segment)))))
         (motion (v2a-clamp01 (v2a-num (nth 6 segment))))
         (chroma-source (v2a-clamp01 (+ (* 0.45 h)
                                        (* 0.20 h-var)
                                        (* 0.20 v-var)
                                        (* 0.10 motion)
                                        (* 0.05 s))))
         (base (truncate (* chroma-source scale-len)))
         (phrase-shift (nth (rem seg-index 8) '(0 0 1 0 2 1 0 1))))
    (v2a-wrap-degree (+ base phrase-shift) scale-len)))

(defun v2a-segment-duration (segment bpm)
  (let* ((raw-sec (max 0.05 (v2a-num (nth 7 segment))))
         (beat-sec (/ 60.0 (max 1.0 (v2a-num bpm))))
         (beats (/ raw-sec beat-sec))
         ; close to v2a-cx expressive grid (1/6 beat) without quarter-note locking
         (grid (/ 1.0 6.0))
         (steps (max 2 (truncate (+ 0.5 (/ (max (/ 1.0 3.0) beats) grid)))))
         (qbeats (* steps grid))
         (blend (+ (* 0.70 qbeats) (* 0.30 beats))))
    (* blend beat-sec)))

(defun v2a-note (pitch dur amp attack decay rel)
  (let* ((p (v2a-num pitch))
         ; Nyquist osc uses step-domain pitch (MIDI-like), not Hz.
         (tone (sum (mult 0.82 (osc p dur))
                    (mult 0.13 (osc (+ p 12.0) dur))
                    (mult 0.05 (osc (+ p 19.0) dur))))
         (shape (env attack decay rel 1.0 0.78 0.35 dur)))
    (mult (v2a-num amp)
          (mult shape tone))))

(defun v2a-poly-note (voices dur attack decay rel)
  (let ((mix (s-rest 0))
        (d (max 0.01 (v2a-num dur))))
    (dolist (voice voices)
      (let ((pitch (if (and (listp voice) (numberp (car voice)))
                       (v2a-num (car voice))
                       60.0))
            (amp (if (and (listp voice) (numberp (cadr voice)))
                     (v2a-num (cadr voice))
                     0.1)))
        (setf mix (sum mix (v2a-note pitch d amp attack decay rel)))))
    mix))

(defun v2a-make-note-event (start dur pitch amp attack decay rel)
  (list (max 0.0 (v2a-num start))
        (max 0.01 (v2a-num dur))
        (list 'v2a-note (v2a-num pitch) 1.0 (v2a-num amp)
              (v2a-num attack) (v2a-num decay) (v2a-num rel))))

(defun v2a-make-poly-event (start dur voices attack decay rel)
  (list (max 0.0 (v2a-num start))
        (max 0.01 (v2a-num dur))
        (list 'v2a-poly-note
              (list 'quote voices)
              1.0
              (v2a-num attack)
              (v2a-num decay)
              (v2a-num rel))))

; Plan tuple:
; (start dur root-degree activity segment seg-index)
(defun v2a-build-plans-rec (segments seg-index now bpm scale-len prev-root)
  (if (null segments)
      nil
      (let* ((segment (car segments))
             (activity (v2a-segment-activity segment))
             (target-root (v2a-target-root-degree segment seg-index scale-len))
             (root-degree
               (if (and prev-root (< activity 0.16))
                   prev-root
                   (v2a-smooth-degree-progression
                     prev-root
                     target-root
                     scale-len
                     (if (> activity 0.55) 2 1))))
             (dur (v2a-segment-duration segment bpm))
             (plan (list now dur root-degree activity segment seg-index)))
        (cons
          plan
          (v2a-build-plans-rec
            (cdr segments)
            (+ seg-index 1)
            (+ now dur)
            bpm
            scale-len
            root-degree)))))

(defun v2a-build-plans (segments bpm scale)
  (v2a-build-plans-rec segments 0 0.0 bpm (max 1 (length scale)) nil))

(defun v2a-segment-span (segment)
  (let* ((hue-var (v2a-clamp01 (v2a-num (nth 3 segment))))
         (sat-var (v2a-clamp01 (* 2.0 (v2a-num (nth 4 segment)))))
         (val-var (v2a-clamp01 (* 2.0 (v2a-num (nth 5 segment))))))
    (v2a-clamp01 (+ (* 0.72 hue-var)
                    (* 0.16 sat-var)
                    (* 0.12 val-var)))))

(defun v2a-plan-end (plan)
  (+ (nth 0 plan) (nth 1 plan)))

(defun v2a-plan-with-window (plan start dur)
  (list start dur (nth 2 plan) (nth 3 plan) (nth 4 plan) (nth 5 plan)))

(defun v2a-list-quantile (xs q)
  (let* ((sorted (sort (append xs nil) #'<))
         (n (length sorted)))
    (if (<= n 0)
        0.0
        (nth (max 0 (min (1- n) (truncate (* (v2a-clamp01 q) (1- n))))) sorted))))

(defun v2a-quantize-window-union-grid (start dur beat-sec)
  (let* ((points (v2a-grid-points '(2 6)))
         (min-dur (* beat-sec (v2a-min-grid-diff points)))
         (s (v2a-quantize-to-grid start beat-sec points))
         (e (v2a-quantize-to-grid (+ start dur) beat-sec points)))
    (if (<= e s)
        (setf e (+ s min-dur))
        nil)
    (list s (- e s))))

(defun v2a-quantize-window-strong-grid (start dur beat-sec)
  (let* ((step (* 2.0 beat-sec))
         (s (* (round (/ start step)) step))
         (e (* (round (/ (+ start dur) step)) step)))
    (if (<= e s)
        (setf e (+ s step))
        nil)
    (list s (- e s))))

(defun v2a-adapt-harmonic-progression-rate (plans beat-sec)
  (if (or (null plans) (null (cdr plans)))
      plans
      (let ((spans nil)
            (deltas nil)
            (prev-span nil)
            (base nil)
            (low-th 0.03)
            (high-th 0.11)
            (out nil)
            (vol-streak 0)
            (calm-streak 0))
        (dolist (plan plans)
          (push (v2a-segment-span (nth 4 plan)) spans))
        (setf spans (reverse spans))
        (dolist (sp spans)
          (if prev-span
              (push (abs (- sp prev-span)) deltas)
              (push 0.0 deltas))
          (setf prev-span sp))
        (setf deltas (reverse deltas))
        (setf base (if (cdr deltas) (cdr deltas) '(0.0)))
        (setf low-th (max 0.03 (min 0.16 (v2a-list-quantile base 0.35))))
        (setf high-th (max (+ low-th 0.08) (min 0.55 (v2a-list-quantile base 0.80))))
        (do ((ps plans (cdr ps))
             (ds deltas (cdr ds)))
            ((null ps) out)
          (let* ((plan (car ps))
                 (delta (if ds (car ds) 0.0))
                 (window
                   (progn
                     (if (>= delta high-th)
                         (progn
                           (setf vol-streak (+ vol-streak 1))
                           (setf calm-streak 0))
                         (if (<= delta low-th)
                             (progn
                               (setf calm-streak (+ calm-streak 1))
                               (setf vol-streak (max 0 (- vol-streak 1))))
                             (progn
                               (setf vol-streak (max 0 (- vol-streak 1)))
                               (setf calm-streak 0))))
                     (if (>= vol-streak 2)
                         (v2a-quantize-window-union-grid (nth 0 plan) (nth 1 plan) beat-sec)
                         (v2a-quantize-window-strong-grid (nth 0 plan) (nth 1 plan) beat-sec))))
                 (p-q (v2a-plan-with-window plan (nth 0 window) (nth 1 window))))
            (if (and out (>= calm-streak 2))
                (let* ((tail (last out))
                       (prev (car tail))
                       (new-end (max (v2a-plan-end prev) (v2a-plan-end p-q))))
                  (setf (car tail)
                        (v2a-plan-with-window prev (nth 0 prev) (- new-end (nth 0 prev)))))
                (setf out (append out (list p-q)))))))))

(defun v2a-plan-harm-shift (activity)
  (if (> activity 0.62) 2 (if (> activity 0.30) 1 0)))

(defun v2a-build-harmony-score (plans scale mood mapping-bias sensitivity)
  (let (events)
    (dolist (plan plans)
      (let* ((start (nth 0 plan))
             (dur (nth 1 plan))
             (root-degree (nth 2 plan))
             (activity (nth 3 plan))
             (segment (nth 4 plan))
             (s (v2a-clamp01 (v2a-num (nth 1 segment))))
             (v (v2a-clamp01 (v2a-num (nth 2 segment))))
             (harm-shift (v2a-plan-harm-shift activity))
             (bias (v2a-clamp01 (v2a-num mapping-bias)))
             (safe-weight (- 1.0 bias))
             (root (v2a-midi-from-scale-degree scale (+ root-degree harm-shift) 48))
             (third (v2a-midi-from-scale-degree scale (+ root-degree harm-shift 2) 48))
             (fifth (v2a-midi-from-scale-degree scale (+ root-degree harm-shift 4) 48))
             (amp (* 0.22 (+ 0.35 (* 0.65 v))))
             (h-amp (* amp (+ 0.55 (* 0.45 safe-weight))))
             (h-dur (max 0.05 dur)))
        (push (v2a-make-note-event start h-dur root h-amp 0.03 0.08 0.12) events)
        (push (v2a-make-note-event start h-dur third (* h-amp 0.82) 0.03 0.08 0.12) events)
        (push (v2a-make-note-event start h-dur fifth (* h-amp 0.72) 0.03 0.08 0.12) events)))
    (reverse events)))

(defun v2a-build-bass-score (plans scale mood mapping-bias sensitivity)
  (let (events)
    (dolist (plan plans)
      (let* ((start (nth 0 plan))
             (dur (nth 1 plan))
             (root-degree (nth 2 plan))
             (activity (nth 3 plan))
             (segment (nth 4 plan))
             (s (v2a-clamp01 (v2a-num (nth 1 segment))))
             (v (v2a-clamp01 (v2a-num (nth 2 segment))))
             (s-var (v2a-clamp01 (* 6.0 (v2a-num (nth 4 segment)))))
             (harm-shift (v2a-plan-harm-shift activity))
             (root (v2a-midi-from-scale-degree scale (+ root-degree harm-shift) 48))
             (bass (- root 12))
             (amp (* 0.22 (+ 0.35 (* 0.65 v))))
             (b-amp (* amp (+ 0.50 (* 0.35 s) (* 0.15 s-var)))))
        (push (v2a-make-note-event start (max 0.05 dur) bass b-amp 0.02 0.08 0.12) events)))
    (reverse events)))

(defun v2a-build-pad-score (plans scale mood mapping-bias sensitivity)
  (let (events)
    (dolist (plan plans)
      (let* ((start (nth 0 plan))
             (dur (nth 1 plan))
             (root-degree (nth 2 plan))
             (activity (nth 3 plan))
             (segment (nth 4 plan))
             (v (v2a-clamp01 (v2a-num (nth 2 segment))))
             (harm-shift (v2a-plan-harm-shift activity))
             (root (v2a-midi-from-scale-degree scale (+ root-degree harm-shift) 48))
             (fifth (v2a-midi-from-scale-degree scale (+ root-degree harm-shift 4) 48))
             (pad-root (+ root 12))
             (pad-fifth (+ fifth 12))
             (amp (* 0.22 (+ 0.35 (* 0.65 v))))
             (p1 (* amp 0.24))
             (p2 (* amp 0.20)))
        (push (v2a-make-note-event start (max 0.05 dur) pad-root p1 0.04 0.12 0.14) events)
        (push (v2a-make-note-event start (max 0.05 dur) pad-fifth p2 0.04 0.12 0.14) events)))
    (reverse events)))

(defun v2a-fit-note-to-range-preserve-pc (note low high prefer)
  (let ((lo (min (truncate low) (truncate high)))
        (hi (max (truncate low) (truncate high)))
        (n (truncate note))
        (target (v2a-num prefer))
        cands)
    (do ((k -8 (+ k 1)))
        ((> k 8) nil)
      (let ((m (+ n (* 12 k))))
        (if (and (>= m lo) (<= m hi))
            (push m cands)
            nil)))
    (if (null cands)
        (truncate (v2a-clamp n lo hi))
        (let* ((best (car cands))
               (best-score (+ (* 8.0 (abs (- best target)))
                              (abs (- best n)))))
          (dolist (m (cdr cands))
            (let ((score (+ (* 8.0 (abs (- m target)))
                            (abs (- m n)))))
              (if (< score best-score)
                  (progn
                    (setf best m)
                    (setf best-score score))
                  nil)))
          best))))

(defun v2a-limit-melody-jump (note prev max-jump low high)
  (let ((n (v2a-fit-note-to-range-preserve-pc note low high (if prev prev note))))
    (if (null prev)
        n
        (let ((cur n)
              (i 0))
          (do ()
              ((or (>= i 6) (<= (abs (- cur prev)) max-jump))
               (v2a-fit-note-to-range-preserve-pc cur low high prev))
            (if (> cur prev)
                (setf cur (- cur 12))
                (setf cur (+ cur 12)))
            (setf i (+ i 1)))))))

(defun v2a-build-melody-score (plans scale mood mapping-bias sensitivity)
  (let (events)
    (let ((prev-note nil))
    (dolist (plan plans)
      (let* ((start (nth 0 plan))
             (dur (nth 1 plan))
             (root-degree (nth 2 plan))
             (activity (nth 3 plan))
             (segment (nth 4 plan))
             (seg-index (nth 5 plan))
             (h-var (v2a-clamp01 (v2a-num (nth 3 segment))))
             (v-var (v2a-clamp01 (* 6.0 (v2a-num (nth 5 segment)))))
             (motion (v2a-clamp01 (v2a-num (nth 6 segment))))
             (v (v2a-clamp01 (v2a-num (nth 2 segment))))
             (register-shift
               (cond
                 ((eq mood 'cheerful) 12)
                 ((eq mood 'epic) -3)
                 (t 0)))
             (motion-gain (+ 1.0 (* (v2a-num sensitivity) (+ 0.20 (* 0.80 (v2a-clamp01 (v2a-num mapping-bias)))))))
             (jump (truncate (* (v2a-clamp01 (+ (* 0.55 motion)
                                                (* 0.25 h-var)
                                                (* 0.20 v-var)))
                               motion-gain
                               3.0)))
             (mel-pattern (nth (rem seg-index 12) '(0 1 2 1 3 2 4 2 3 1 2 0)))
             (n1 (v2a-midi-from-scale-degree scale (+ root-degree 5 mel-pattern jump) (+ 60 register-shift)))
             (n2 (v2a-midi-from-scale-degree scale (+ root-degree 2 mel-pattern) (+ 59 register-shift)))
             (n3 (v2a-midi-from-scale-degree scale (+ root-degree 7 mel-pattern) (+ 61 register-shift)))
             (m1 (v2a-limit-melody-jump n1 prev-note 9 57 88))
             (m2 (v2a-limit-melody-jump n2 m1 9 57 88))
             (m3 (v2a-limit-melody-jump n3 m2 10 57 88))
             (amp (* 0.22 (+ 0.35 (* 0.65 v))))
             (m-amp (* amp (+ 0.44 (* 0.36 motion) (* 0.20 h-var))))
             (detail (+ (* 0.62 activity) (* 0.22 motion) (* 0.16 h-var)))
             (note-count (cond ((> detail 0.60) 3)
                               ((or (> detail 0.22)
                                    (= (rem seg-index 4) 2))
                                2)
                               (t 1)))
             (d1 (max 0.06 (* dur 0.55)))
             (d2 (max 0.05 (* dur 0.30)))
             (d3 (max 0.05 (* dur 0.22))))
        (push (v2a-make-note-event (+ start (* 0.05 dur)) d1 m1 m-amp 0.02 0.10 0.14) events)
        (if (> note-count 1)
            (push (v2a-make-note-event (+ start (* 0.42 dur)) d2 m2 (* m-amp 0.82) 0.02 0.10 0.14) events)
            nil)
        (if (> note-count 2)
            (push (v2a-make-note-event (+ start (* 0.73 dur)) d3 m3 (* m-amp 0.72) 0.02 0.10 0.14) events)
            nil)
        (setf prev-note (if (> note-count 2) m3 (if (> note-count 1) m2 m1)))))
    (reverse events))))

(defun v2a-normalize-step-set (spec)
  (cond
    ((null spec) '(4))
    ((numberp spec) (list (max 1 (truncate spec))))
    ((listp spec)
     (let (out)
       (dolist (x spec)
         (if (numberp x)
             (push (max 1 (truncate x)) out)
             nil))
       (if out (reverse out) '(4))))
    (t '(4))))

(defun v2a-grid-points (step-set)
  (let ((raw '(0.0 1.0)))
    (dolist (spb (v2a-normalize-step-set step-set))
      (let ((n (max 1 (truncate spb))))
        (do ((k 1 (+ k 1)))
            ((>= k n) nil)
          (push (/ (float k) (float n)) raw))))
    (setf raw (sort raw #'<))
    (let ((out nil)
          (prev nil))
      (dolist (p raw)
        (if (or (null prev) (> (abs (- p prev)) 0.000001))
            (progn
              (push p out)
              (setf prev p))
            nil))
      (reverse out))))

(defun v2a-min-grid-diff (points)
  (let ((prev nil)
        (best 1.0))
    (dolist (p points)
      (if prev
          (if (and (> (- p prev) 0.000001)
                   (< (- p prev) best))
              (setf best (- p prev))
              nil)
          nil)
      (setf prev p))
    (max 0.0001 best)))

(defun v2a-quantize-to-grid (time-sec beat-sec points)
  (let* ((beats (/ (max 0.0 (v2a-num time-sec)) (max 1e-6 (v2a-num beat-sec))))
         (base (truncate beats))
         (frac (- beats base))
         (best-point 0.0)
         (best-dist 1e9))
    (dolist (p points)
      (let ((d (abs (- frac p))))
        (if (< d best-dist)
            (progn
              (setf best-dist d)
              (setf best-point p))
            nil)))
    (* (+ base best-point) beat-sec)))

(defun v2a-quantize-event (event beat-sec points min-dur)
  (let* ((s (v2a-quantize-to-grid (event-time event) beat-sec points))
         (e (v2a-quantize-to-grid (+ (event-time event) (event-dur event)) beat-sec points))
         (d (if (> (- e s) min-dur)
                (- e s)
                min-dur)))
    (list s d (event-expression event))))

(defun v2a-quantize-score (score beat-sec step-set)
  (let* ((points (v2a-grid-points step-set))
         (min-dur (* beat-sec (v2a-min-grid-diff points)))
         (events (sort (append score nil) #'event-before))
         out)
    (dolist (ev events)
      (if (and (consp (event-expression ev))
               (eq (car (event-expression ev)) 'SCORE-BEGIN-END))
          nil
          (push (v2a-quantize-event ev beat-sec points min-dur) out)))
    (score-sort (score-must-have-begin-end (reverse out)))))

(defun v2a-score-pitch-range (score)
  (let ((mn nil)
        (mx nil))
    (dolist (ev score)
      (let* ((expr (if (and (listp ev) (>= (length ev) 3)) (nth 2 ev) nil))
             (head (if (listp expr) (car expr) nil))
             (pitch (if (and (eq head 'v2a-note)
                             (numberp (nth 1 expr)))
                        (v2a-num (nth 1 expr))
                        nil)))
        (if pitch
            (progn
              (if (or (null mn) (< pitch mn)) (setf mn pitch) nil)
              (if (or (null mx) (> pitch mx)) (setf mx pitch) nil))
            nil)))
    (if (and mn mx)
        (list mn mx)
        '(none none))))

(defun v2a-note-event-compatible-p (ev ref-time ref-dur ref-a ref-d ref-r)
  (let* ((expr (event-expression ev)))
    (and (= (event-time ev) ref-time)
         (= (event-dur ev) ref-dur)
         (consp expr)
         (eq (car expr) 'v2a-note)
         (= (v2a-num (nth 4 expr)) ref-a)
         (= (v2a-num (nth 5 expr)) ref-d)
         (= (v2a-num (nth 6 expr)) ref-r))))

(defun v2a-collapse-note-group (group)
  (if (or (null group) (null (cdr group)))
      (car group)
      (let* ((first (car group))
             (expr (event-expression first))
             (voices nil))
        (dolist (ev group)
          (let ((e (event-expression ev)))
            (push (list (v2a-num (nth 1 e))
                        (v2a-num (nth 3 e)))
                  voices)))
        (v2a-make-poly-event
          (event-time first)
          (event-dur first)
          (reverse voices)
          (v2a-num (nth 4 expr))
          (v2a-num (nth 5 expr))
          (v2a-num (nth 6 expr))))))

(defun v2a-collapse-simultaneous-score (score)
  (let* ((events (sort (append score nil) #'event-before))
         (out nil)
         (group nil)
         (ref-time nil)
         (ref-dur nil)
         (ref-a nil)
         (ref-d nil)
         (ref-r nil))
    (dolist (ev events)
      (let ((expr (event-expression ev)))
        (cond
          ((and (consp expr) (eq (car expr) 'SCORE-BEGIN-END))
           nil)
          ((and (consp expr) (eq (car expr) 'v2a-note))
           (let ((a (v2a-num (nth 4 expr)))
                 (d (v2a-num (nth 5 expr)))
                 (r (v2a-num (nth 6 expr))))
             (if (and group
                      (v2a-note-event-compatible-p ev ref-time ref-dur ref-a ref-d ref-r))
                 (push ev group)
                 (progn
                   (if group
                       (push (v2a-collapse-note-group (reverse group)) out)
                       nil)
                   (setf group (list ev))
                   (setf ref-time (event-time ev))
                   (setf ref-dur (event-dur ev))
                   (setf ref-a a)
                   (setf ref-d d)
                   (setf ref-r r)))))
          (t
           (if group
               (progn
                 (push (v2a-collapse-note-group (reverse group)) out)
                 (setf group nil)))
           (push ev out)))))
    (if group
        (push (v2a-collapse-note-group (reverse group)) out)
        nil)
    (score-sort (score-must-have-begin-end (reverse out)))))

(defun v2a-render-track-score (score)
  (let ((prepared (v2a-collapse-simultaneous-score score)))
    (if (or (null prepared) (and (= (length prepared) 1)))
        (s-rest 0)
        (timed-seq prepared))))

(defun v2a-meta-value (meta key default)
  (let ((entry (assoc key meta)))
    (if entry (nth 1 entry) default)))

(defun v2a-score-from-track-data (rows)
  (let (events)
    (dolist (row rows)
      (if (and (listp row) (>= (length row) 7))
          (push
            (v2a-make-note-event
              (nth 0 row)
              (nth 1 row)
              (nth 2 row)
              (nth 3 row)
              (nth 4 row)
              (nth 5 row)
              (nth 6 row))
            events)
          nil))
    (score-sort (score-must-have-begin-end (reverse events)))))

(defun v2a-render-from-track-data (output-path sample-rate)
  (let* ((meta (if (boundp '*v2a-meta*) *v2a-meta* nil))
         (harmony-q (v2a-score-from-track-data (if (boundp '*v2a-harmony-events*) *v2a-harmony-events* nil)))
         (bass-q (v2a-score-from-track-data (if (boundp '*v2a-bass-events*) *v2a-bass-events* nil)))
         (pad-q (v2a-score-from-track-data (if (boundp '*v2a-pad-events*) *v2a-pad-events* nil)))
         (melody-q (v2a-score-from-track-data (if (boundp '*v2a-melody-events*) *v2a-melody-events* nil)))
         (merged (score-merge harmony-q bass-q pad-q melody-q)))
    (setf *sound-srate* (float (max 8000 (truncate (v2a-num sample-rate)))))
    (let ((piece
            (sum
              (v2a-render-track-score harmony-q)
              (sum
                (v2a-render-track-score bass-q)
                (sum
                  (v2a-render-track-score pad-q)
                  (v2a-render-track-score melody-q))))))
      (format t "NYQ | flow=reference-tracks->score-merge->render~%")
      (format t "NYQ | segments=~A bpm=~A scale=~A mood=~A activity=~A melody_spb=~A~%"
              (v2a-meta-value meta 'segments 0)
              (v2a-meta-value meta 'bpm 120)
              (v2a-meta-value meta 'scale 'major)
              (v2a-meta-value meta 'mood 'none)
              (v2a-meta-value meta 'activity 0.0)
              (v2a-meta-value meta 'melody-spb 4))
      (format t "NYQ | tempo ref=~A render=~A raw=~A target=~A~%"
              (v2a-meta-value meta 'reference-bpm 120.0)
              (v2a-meta-value meta 'render-bpm 120.0)
              (v2a-meta-value meta 'raw-duration 0.0)
              (v2a-meta-value meta 'target-duration 0.0))
      (format t "NYQ | plans raw/harmonic=~A/~A~%"
              (v2a-meta-value meta 'plans 0)
              (v2a-meta-value meta 'harmonic-plans 0))
      (format t "NYQ | tracks q(H/B/P/M)=~A/~A/~A/~A merged=~A~%"
              (length harmony-q) (length bass-q) (length pad-q) (length melody-q) (length merged))
      (format t "NYQ | pitch raw(H/B/P/M)=~A/~A/~A/~A~%"
              (v2a-score-pitch-range harmony-q)
              (v2a-score-pitch-range bass-q)
              (v2a-score-pitch-range pad-q)
              (v2a-score-pitch-range melody-q))
      (s-save (mult 0.92 piece) ny:all output-path)
      (format t "NYQ | wrote=~A~%" output-path)
      piece)))

(defun v2a-render-from-features
       (segments output-path tempo-override scale-override mood mapping-bias sensitivity sample-rate)
  (let* ((resolved-mood
           (cond
             ((eq mood 'cheerful) 'cheerful)
             ((eq mood 'epic) 'epic)
             (t 'none)))
         (resolved-scale
           (if (and scale-override (v2a-known-scale-p scale-override))
               scale-override
               (v2a-resolve-scale segments nil resolved-mood)))
         (scale (v2a-scale-intervals resolved-scale))
         (bpm (if (> (v2a-num tempo-override) 0.0)
                  (truncate (v2a-clamp (v2a-num tempo-override) 40.0 200.0))
                  (v2a-auto-bpm segments resolved-mood)))
         (beat-sec (/ 60.0 (max 1.0 (v2a-num bpm))))
         (global-motion (v2a-mean (v2a-column segments 6)))
         (global-hue-var (v2a-mean (v2a-column segments 3)))
         (global-sat-var (v2a-clamp01 (* 6.0 (v2a-mean (v2a-column segments 4)))))
         (global-val-var (v2a-clamp01 (* 6.0 (v2a-mean (v2a-column segments 5)))))
         (global-activity (v2a-clamp01 (+ (* 0.50 global-motion)
                                          (* 0.22 global-hue-var)
                                          (* 0.16 global-sat-var)
                                          (* 0.12 global-val-var))))
         (melody-spb (if (> global-activity 0.56) 6 4))
         (plans (v2a-build-plans segments bpm scale))
         (harmonic-plans (v2a-adapt-harmonic-progression-rate plans beat-sec))
         (harmony-raw (v2a-build-harmony-score harmonic-plans scale resolved-mood mapping-bias sensitivity))
         (bass-raw (v2a-build-bass-score harmonic-plans scale resolved-mood mapping-bias sensitivity))
         (pad-raw (v2a-build-pad-score harmonic-plans scale resolved-mood mapping-bias sensitivity))
         (melody-raw (v2a-build-melody-score plans scale resolved-mood mapping-bias sensitivity))
         ; post-production quantization per track
         (harmony-q (v2a-quantize-score harmony-raw beat-sec '(2 6)))
         (bass-q (v2a-quantize-score bass-raw beat-sec '(1)))
         (pad-q (v2a-quantize-score pad-raw beat-sec '(1)))
         (melody-q (v2a-quantize-score melody-raw beat-sec (list melody-spb)))
         ; merge tracks explicitly via score-merge
         (merged (score-merge harmony-q bass-q pad-q melody-q)))
    (setf *sound-srate* (float (max 8000 (truncate (v2a-num sample-rate)))))
    (let ((piece
            (if (null segments)
                (s-rest 0)
                (sum
                  (v2a-render-track-score harmony-q)
                  (sum
                    (v2a-render-track-score bass-q)
                    (sum
                      (v2a-render-track-score pad-q)
                      (v2a-render-track-score melody-q)))))))
      (format t "NYQ | flow=mapping->plans->tracks->quantize->score-merge~%")
      (format t "NYQ | segments=~A bpm=~A scale=~A mood=~A activity=~A melody_spb=~A~%"
              (length segments) bpm resolved-scale resolved-mood global-activity melody-spb)
      (format t "NYQ | plans raw/harmonic=~A/~A~%" (length plans) (length harmonic-plans))
      (format t "NYQ | tracks raw(H/B/P/M)=~A/~A/~A/~A~%"
              (length harmony-raw) (length bass-raw) (length pad-raw) (length melody-raw))
      (format t "NYQ | tracks q(H/B/P/M)=~A/~A/~A/~A merged=~A~%"
              (length harmony-q) (length bass-q) (length pad-q) (length melody-q) (length merged))
      (format t "NYQ | pitch raw(H/B/P/M)=~A/~A/~A/~A~%"
              (v2a-score-pitch-range harmony-raw)
              (v2a-score-pitch-range bass-raw)
              (v2a-score-pitch-range pad-raw)
              (v2a-score-pitch-range melody-raw))
      (s-save (mult 0.92 piece) ny:all output-path)
      (format t "NYQ | wrote=~A~%" output-path)
      piece)))
